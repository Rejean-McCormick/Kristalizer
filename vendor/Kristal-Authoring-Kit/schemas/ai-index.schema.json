{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:ai-index:1.0",
  "title": "Kristal AI File Index",
  "type": "object",
  "required": [
    "format",
    "state_ref",
    "state_logical_commitment",
    "files"
  ],
  "properties": {
    "format": {
      "const": "kristal.ai-index/1.0"
    },
    "state_ref": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "materialization_blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
