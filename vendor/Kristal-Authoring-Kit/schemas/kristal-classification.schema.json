{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:classification/1.0",
  "title": "Optional Arketype-origin design classification (not authority)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "arketype_version": {
      "type": "string",
      "minLength": 1
    },
    "primary_archetype": {
      "type": "string",
      "pattern": "^ARK-[0-9]{2,}$"
    },
    "supporting_archetypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ARK-[0-9]{2,}$"
      }
    },
    "primary_usage": {
      "type": "string",
      "pattern": "^PRF-[0-9]{2,}$"
    },
    "secondary_usages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PRF-[0-9]{2,}$"
      }
    },
    "usage_slug": {
      "type": "string",
      "minLength": 1
    },
    "usage_family": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "enum": [
        "single",
        "collection",
        "federation",
        "hybrid",
        "unknown"
      ]
    }
  }
}
